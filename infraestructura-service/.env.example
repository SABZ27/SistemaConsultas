# ==========================
# Servidor
# ==========================
PORT=3001

# ==========================
# Base de datos MySQL (infraestructura)
# ==========================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sistema_consultas_infra
DB_CONNECTION_LIMIT=10
# DB_SSL=true cifra la conexión a MySQL (obligatorio en algunos proveedores
# gestionados). Déjalo en false para MySQL local.
DB_SSL=false

# ==========================
# JWT (mismo JWT_SECRET que FastAPI)
# ==========================
JWT_SECRET=REEMPLAZAR_POR_UN_SECRET_DE_AL_MENOS_32_CARACTERES

# ==========================
# CORS
# ==========================
# Lista separada por comas. Usa * para permitir cualquier origen (solo desarrollo).
CORS_ORIGINS=*

# ==========================
# Base de datos de pruebas (jest + supertest)
# ==========================
# Conexión de la base de pruebas. Si no se define, se toman DB_HOST/DB_PORT/DB_USER/DB_PASSWORD.
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=3307
TEST_DB_USER=root
TEST_DB_PASSWORD=
# Nombre de la base de pruebas. Si no se define, se usa "sistema_consultas_infra_test".
# Debe terminar en "_test": el arranque aborta si no es así.
TEST_DB_NAME=sistema_consultas_infra_test
