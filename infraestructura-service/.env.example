# ==========================
# Servidor
# ==========================
PORT=3001

# ==========================
# Base de datos MySQL (servicios externos)
# ==========================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sistema_consultas_infra
DB_CONNECTION_LIMIT=10
# DB_SSL=true cifra la conexión a MySQL (obligatorio en algunos proveedores
# gestionados). Déjalo en false para MySQL local.
DB_SSL=false

# ==========================
# JWT (mismo JWT_SECRET que FastAPI)
# ==========================
JWT_SECRET=REEMPLAZAR_POR_UN_SECRET_DE_AL_MENOS_32_CARACTERES

# ==========================
# CORS
# ==========================
# Lista separada por comas. Usa * para permitir cualquier origen (solo desarrollo).
CORS_ORIGINS=*

# ==========================
# Proveedores externos
# ==========================
# La url_base de cada proveedor vive en la tabla servicios_externos (se siembra
# con `npm run db:init`). Si la fila no existe, el servicio responde 503.
# Codigo de pais (ISO 3166-1 alfa-2) consultado en Nager.Date.
NAGER_PAIS=CO
# Tiempo maximo de espera de una llamada a un proveedor, en milisegundos.
HTTP_TIMEOUT_MS=15000

# ==========================
# Correo (API HTTP de Brevo, no SMTP)
# ==========================
# API key de Brevo: solo se lee del entorno, nunca se guarda en la base de
# datos ni se expone por la API.
EMAIL_PROVIDER_API_KEY=
# Remitente del correo (debe estar verificado en Brevo).
EMAIL_FROM=
EMAIL_FROM_NAME=Sistema de Consultas

# ==========================
# Base de datos de pruebas (jest + supertest)
# ==========================
# Conexión de la base de pruebas. Si no se define, se toman DB_HOST/DB_PORT/DB_USER/DB_PASSWORD.
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=3307
TEST_DB_USER=root
TEST_DB_PASSWORD=
# Nombre de la base de pruebas. Si no se define, se usa "sistema_consultas_infra_test".
# Debe terminar en "_test": el arranque aborta si no es así.
TEST_DB_NAME=sistema_consultas_infra_test
