# =============================================================================
# ia/.env.example - SOLO NOMBRES DE VARIABLES (sin secretos reales).
# Copia este archivo a ia/.env, rellena los valores y NO lo subas a git
# (ia/.gitignore ya lo ignora). Los secretos van en variables de entorno.
# Archivo escrito sin tildes para que Windows PowerShell 5 lo lea sin problemas.
# =============================================================================

# --- Modo de Open WebUI: pip (por defecto, sin Docker) | docker (alternativo) ---
OPENWEBUI_MODE=pip
OPENWEBUI_URL=http://localhost:3000
OPENWEBUI_PORT=3000

# --- Open WebUI (pip) ---
# WEBUI_SECRET_KEY: clave estable de sesion (cadena larga y aleatoria, no compartir).
WEBUI_SECRET_KEY=
# OPENWEBUI_API_KEY: clave de API (Settings > Account > API Keys), prefijo sk-.
OPENWEBUI_API_KEY=
KNOWLEDGE_ID=
KNOWLEDGE_NAME=consultas-academicas
DATA_DIR=C:\dev\openwebui-data
VENV_OPENWEBUI=C:\dev\venv-openwebui
# En modo pip Ollama se detecta en localhost; en modo docker usa host.docker.internal.
OLLAMA_BASE_URL=http://localhost:11434

# --- Ollama ---
# Modelo derivado creado por ia/scripts/instalar-modelo.ps1
OLLAMA_MODEL=consultas-asistente
OLLAMA_MODELO_BASE=qwen3:4b-instruct-2507-q4_K_M
# Evita que el modelo se descargue a los 5 min (primera respuesta lenta).
OLLAMA_KEEP_ALIVE=30m
# Solo MODO DOCKER: poner 0.0.0.0 si el contenedor no alcanza Ollama.
OLLAMA_HOST=

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Lista blanca opcional de ids de Telegram separados por coma. Vacio = todos.
# La ruta DATOS solo funciona si aqui hay al menos un id.
TELEGRAM_ALLOWED_USERS=
# auto | documentacion | datos
ROUTING_MODE=auto
TELEGRAM_TIMEOUT_SEGUNDOS=300

# --- Fase 2: herramientas / BD (solo nombres; rellenar al llegar la Fase 2) ---
# ids de herramientas de Open WebUI separados por coma (GET /api/v1/tools/).
OPENWEBUI_TOOL_IDS=
MCPO_API_KEY=
MCPO_URL=http://localhost:8000
MCPO_PORT=8000
# streamable-http (Toolbox reciente) | sse (Toolbox antiguo)
MCPO_SERVER_TYPE=streamable-http
MCPO_UPSTREAM_URL=http://127.0.0.1:5000/mcp
VENV_MCPO=C:\dev\venv-mcpo
TOOLBOX_EXE=ia/bin/toolbox.exe
TOOLBOX_PORT=5000
TOOLBOX_CONFIG=ia/db/tools.yaml

# --- Fase 2: conexion a Neon (PostgreSQL, solo nombres; SSL obligatorio) ---
NEON_HOST=
NEON_PORT=5432
NEON_DATABASE=
NEON_USER=
NEON_PASSWORD=
NEON_SSLMODE=require
