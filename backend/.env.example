# ==========================
# Base de datos (Neon PostgreSQL)
# ==========================
# Cadena de conexión que te entrega Neon (reemplaza con la tuya).
# Si se define DB_URL, se ignora la configuración por partes.
DB_URL=
# Ejemplo:
# DB_URL=postgresql://usuario:password@<HOST_NEON_VERIFICACION>/sistema_consultas?sslmode=require

# Configuración alternativa por partes (usada si DB_URL está vacía)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=sistema_consultas

# ==========================
# JWT
# ==========================
# Debe tener al menos 32 caracteres.
JWT_SECRET=REEMPLAZAR_POR_UN_SECRET_DE_AL_MENOS_32_CARACTERES
JWT_EXPIRATION_MINUTES=30

# ==========================
# Administrador inicial (semilla idempotente al arrancar)
# ==========================
# Se crea automáticamente SOLO si no existe ningún administrador en la base de
# datos. Si falta alguna de las tres variables, NO se crea y se registra una
# advertencia en el log (sin imprimir los valores).
ADMIN_CORREO=
ADMIN_PASSWORD=
ADMIN_IDENTIFICACION=